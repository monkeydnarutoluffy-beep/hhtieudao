/* ===== HH3D v7.4.31 - Hoang Vuc: always prefer counter element ===== */
(() => {
    'use strict';
    const CHECKBOX_ID = 'hoangvuc-maximize-damage';

    const persistEnabled = () => {
        try { localStorage.setItem(__HH3D_HOANG_VUC_FORCE_KEY__, 'true'); } catch {}
        try {
            const raw = localStorage.getItem(__HH3D_LOCAL_SETTINGS_V2_KEY__) || '{}';
            const settings = JSON.parse(raw);
            settings[__HH3D_HOANG_VUC_FORCE_KEY__] = 'true';
            localStorage.setItem(__HH3D_LOCAL_SETTINGS_V2_KEY__, JSON.stringify(settings));
        } catch {}
    };

    const enforceCheckbox = () => {
        const checkbox = document.getElementById(CHECKBOX_ID);
        if (!checkbox) return;
        if (!checkbox.checked) checkbox.checked = true;
        persistEnabled();
    };

    document.addEventListener('change', event => {
        if (event.target?.id !== CHECKBOX_ID) return;
        if (!event.target.checked) event.target.checked = true;
        persistEnabled();
    }, true);

    const start = () => {
        enforceCheckbox();
        if (!document.documentElement || typeof MutationObserver !== 'function') return;
        new MutationObserver(enforceCheckbox).observe(document.documentElement, {
            childList: true,
            subtree: true
        });
    };

    persistEnabled();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
    else start();
})();


