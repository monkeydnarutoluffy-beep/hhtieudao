/* ===== HH3D Luyen Dan - Auto Phan Giai <=4★ =====
 * - Them option <=4★ vao dropdown "Tu phan giai dan cap".
 * - Luu nguong vao localStorage key chuan cua Auto Luyen Dan:
 *     ld_standalone_decomp_max_star
 * - Khoi phuc sau F5 va dong bo 1 lan voi listener goc.
 * - Neu chon <=4★, tu tat "Tu dung dan 4★" de 4★ thuc su duoc phan giai
 *   thay vi bi luong Auto can dan 4★ xu ly truoc.
 */
(() => {
    'use strict';

    const STORAGE_KEY = 'ld_standalone_decomp_max_star';
    const BOUND_ATTR = 'data-hh3d-decomp4-bound';
    const SYNC_ATTR = 'data-hh3d-decomp4-synced';
    let scanTimer = null;

    const norm = (value) => String(value ?? '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

    function getLabelText(el) {
        try {
            const parts = [];
            if (el.id) {
                const safeId = window.CSS?.escape
                    ? CSS.escape(el.id)
                    : el.id.replace(/(["\\])/g, '\\$1');
                const label = document.querySelector(`label[for="${safeId}"]`);
                if (label) parts.push(label.textContent || '');
            }

            let node = el.parentElement;
            for (let i = 0; node && i < 3; i++, node = node.parentElement) {
                parts.push(node.textContent || '');
            }
            return norm(parts.join(' '));
        } catch {
            return '';
        }
    }

    function looksLikeDecompSelect(el) {
        if (!el || el.tagName !== 'SELECT') return false;

        const id = norm(el.id);
        if (id === 'ld-decomp-star-select' || id.includes('decomp') || id.includes('phan-giai')) {
            return true;
        }

        const text = getLabelText(el);
        if (
            text.includes('tu phan giai dan cap')
            || text.includes('auto phan giai')
            || (text.includes('phan giai') && text.includes('dan'))
        ) {
            const values = [...el.options].map(o => String(o.value));
            return values.includes('2') || values.includes('3');
        }

        return false;
    }

    function findDecompSelect() {
        const known = document.querySelector('#ld-decomp-star-select');
        if (looksLikeDecompSelect(known)) return known;

        return [...document.querySelectorAll('select')].find(looksLikeDecompSelect) || null;
    }

    function looksLikeAutoUse4Checkbox(el) {
        if (!el || el.tagName !== 'INPUT' || String(el.type).toLowerCase() !== 'checkbox') return false;
        const text = getLabelText(el);
        return (
            text.includes('tu dung dan 4')
            || text.includes('auto can dan >=4')
            || text.includes('auto can dan 4')
            || (text.includes('4') && text.includes('hoan hao') && text.includes('dan'))
        );
    }

    function findAutoUse4Checkbox() {
        return [...document.querySelectorAll('input[type="checkbox"]')]
            .find(looksLikeAutoUse4Checkbox) || null;
    }

    function fire(el, type) {
        try {
            el.dispatchEvent(new Event(type, { bubbles: true }));
        } catch {}
    }

    function readSaved() {
        try {
            const n = parseInt(localStorage.getItem(STORAGE_KEY) || '3', 10);
            return [2, 3, 4].includes(n) ? n : 3;
        } catch {
            return 3;
        }
    }

    function save(value) {
        const parsed = parseInt(value, 10);
        const maxStar = [2, 3, 4].includes(parsed) ? parsed : 3;
        try {
            localStorage.setItem(STORAGE_KEY, String(maxStar));
        } catch {}
        return maxStar;
    }

    function disableAutoUse4IfNeeded() {
        const checkbox = findAutoUse4Checkbox();
        if (!checkbox || !checkbox.checked) return false;

        checkbox.checked = false;
        fire(checkbox, 'input');
        fire(checkbox, 'change');

        console.log(
            '[LuyenDan <=4★] Đã tắt "Tự dùng đan 4★" vì chế độ phân giải <=4★ cần quyền xử lý đan 4★.'
        );
        return true;
    }

    function ensureOption4(select) {
        let opt4 = [...select.options].find(o => String(o.value) === '4');

        if (!opt4) {
            opt4 = document.createElement('option');
            opt4.value = '4';
            opt4.textContent = '≤ 4★';

            // Chen sau option 3 neu co, neu khong thi append cuoi.
            const opt3 = [...select.options].find(o => String(o.value) === '3');
            if (opt3?.nextSibling) select.insertBefore(opt4, opt3.nextSibling);
            else select.appendChild(opt4);

            console.log('[LuyenDan <=4★] Đã thêm tùy chọn phân giải ≤4★.');
        } else {
            // Chuan hoa label cho dong bo UI.
            opt4.textContent = '≤ 4★';
        }

        return opt4;
    }

    function syncRuntimeOnce(select) {
        if (select.getAttribute(SYNC_ATTR) === '1') return;
        select.setAttribute(SYNC_ATTR, '1');

        const saved = readSaved();
        if (String(select.value) !== String(saved)) {
            select.value = String(saved);
        }

        // Phat change 1 lan sau khi listener goc da duoc gan.
        setTimeout(() => {
            if (!document.documentElement.contains(select)) return;
            if (String(select.value) !== String(saved)) select.value = String(saved);

            if (saved === 4) disableAutoUse4IfNeeded();

            fire(select, 'input');
            fire(select, 'change');

            // Listener goc co the ghi lai gia tri; ep key chuan sau event.
            setTimeout(() => save(saved), 0);
        }, 700);
    }

    function bind(select) {
        if (!select || select.getAttribute(BOUND_ATTR) === '1') return;
        select.setAttribute(BOUND_ATTR, '1');

        ensureOption4(select);

        const saved = readSaved();
        if (String(select.value) !== String(saved)) {
            select.value = String(saved);
        }

        // Capture phase: luu ngay lua chon truoc listener goc.
        select.addEventListener('change', event => {
            const selected = save(event.target.value);

            if (selected === 4) {
                disableAutoUse4IfNeeded();
            }

            // Listener goc co the clamp/ghi de; luu lai sau khi event ket thuc.
            setTimeout(() => {
                save(selected);
                if (String(select.value) !== String(selected)) {
                    select.value = String(selected);
                }
            }, 0);

            console.log(`[LuyenDan <=4★] Ngưỡng tự phân giải: ≤${selected}★.`);
        }, true);

        syncRuntimeOnce(select);
    }

    function scan() {
        scanTimer = null;
        const select = findDecompSelect();
        if (select) {
            ensureOption4(select);
            bind(select);
        }
    }

    function scheduleScan() {
        if (scanTimer) return;
        scanTimer = setTimeout(scan, 100);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleScan, { once: true });
    } else {
        scheduleScan();
    }

    const observer = new MutationObserver(scheduleScan);
    observer.observe(document.documentElement || document, {
        childList: true,
        subtree: true
    });

    // Neu nguoi dung bat lai Auto dung dan 4★ trong khi decomp=4,
    // dua decomp ve 3 de tranh hai luong tranh nhau xu ly cung mot vien.
    document.addEventListener('change', event => {
        const target = event.target;
        if (!looksLikeAutoUse4Checkbox(target) || !target.checked) return;
        if (readSaved() !== 4) return;

        const select = findDecompSelect();
        save(3);
        if (select) {
            select.value = '3';
            fire(select, 'input');
            fire(select, 'change');
        }

        console.log(
            '[LuyenDan <=4★] "Tự dùng đan 4★" vừa bật, đã hạ ngưỡng phân giải về ≤3★ để tránh xung đột.'
        );
    }, true);

    try {
        const w = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
        w.hh3dLuyenDanDecomp4 = {
            get: () => readSaved(),
            set: value => {
                const n = save(value);
                const select = findDecompSelect();
                if (select) {
                    ensureOption4(select);
                    select.value = String(n);
                    if (n === 4) disableAutoUse4IfNeeded();
                    fire(select, 'input');
                    fire(select, 'change');
                }
                return n;
            },
            storageKey: STORAGE_KEY
        };
    } catch {}
})();


