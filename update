// ==UserScript==
// @name          HH3D - Menu Tùy Chỉnh
// @namespace     Tampermonkey
// @version       7.4.34
// @description   Sửa Hoang Vực: đọc HH3DBossConfig.nonce và attackToken theo mã trang
// @author        Dr. Trune
// @include      /^https?:\/\/(?:[^\/]+\.)?hoathinh3d\.[^\/]+(?:\/.*)?$/
// @noframes
// @run-at        document-start
// @exclude       *://*/phap-tuong*
// @exclude       *://*/tran-phap*
// @require       https://cdn.jsdelivr.net/npm/sweetalert2@11.26.12/dist/sweetalert2.all.min.js
// @run-at        document-start
// @grant         unsafeWindow
// @grant         GM_getValue
// @grant         GM_setValue
// @grant         GM_deleteValue
// @grant         GM_registerMenuCommand
// @grant         GM_xmlhttpRequest
// @connect       docs.google.com
// @connect       docs.googleusercontent.com
// @icon          😂
// ==/UserScript==


/* ===== HH3D v7.4.34 - Portable Config v2 + Khoang Mach config enforcement ===== */
const __HH3D_NATIVE_LOCAL_STORAGE__ = (() => {
    try {
        return window.localStorage;
    } catch {
        return null;
    }
})();

const __HH3D_PORTABLE_BOX_KEY__ = '__hh3d_portable_config_v2__';
const __HH3D_PORTABLE_OLD_BOX_KEY__ = '__hh3d_portable_config_v1__';
const __HH3D_RESTORE_GUARD_KEY__ = '__hh3d_portable_restore_guard_v2__';
const __HH3D_PORTABLE_FORMAT__ = 'HH3D_PORTABLE_CONFIG';
const __HH3D_LOCAL_SETTINGS_V2_KEY__ = '__hh3d_local_settings_v2__';
const __HH3D_HOANG_VUC_FORCE_KEY__ = 'hoangvucMaximizeDamage';

function __hh3dPortableNormalizeStoredValue(key, value) {
    const name = String(key ?? '');
    if (name === __HH3D_HOANG_VUC_FORCE_KEY__) return 'true';
    if (name !== __HH3D_LOCAL_SETTINGS_V2_KEY__) return value;

    let settings = {};
    try {
        const parsed = typeof value === 'string' ? JSON.parse(value || '{}') : value;
        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) settings = { ...parsed };
    } catch {}
    settings[__HH3D_HOANG_VUC_FORCE_KEY__] = 'true';
    return JSON.stringify(settings);
}

function __hh3dPortableNormalizeItems(items) {
    const normalized = { ...(items || {}) };
    normalized[__HH3D_HOANG_VUC_FORCE_KEY__] = 'true';
    if (Object.prototype.hasOwnProperty.call(normalized, __HH3D_LOCAL_SETTINGS_V2_KEY__)) {
        normalized[__HH3D_LOCAL_SETTINGS_V2_KEY__] = __hh3dPortableNormalizeStoredValue(
            __HH3D_LOCAL_SETTINGS_V2_KEY__,
            normalized[__HH3D_LOCAL_SETTINGS_V2_KEY__]
        );
    }
    return normalized;
}

function __hh3dGmGet(key, fallback = null) {
    try { return typeof GM_getValue === 'function' ? GM_getValue(key, fallback) : fallback; }
    catch { return fallback; }
}

function __hh3dGmSet(key, value) {
    if (typeof GM_setValue !== 'function') throw new Error('GM_setValue khong kha dung');
    GM_setValue(key, value);
}

function __hh3dPortableReadBox() {
    try {
        let raw = __hh3dGmGet(__HH3D_PORTABLE_BOX_KEY__, null);
        let fromV1 = false;
        if (!raw) {
            raw = __hh3dGmGet(__HH3D_PORTABLE_OLD_BOX_KEY__, null);
            fromV1 = !!raw;
        }

        if (raw && typeof raw === 'object' && !Array.isArray(raw)) {
            const items = raw.items && typeof raw.items === 'object' && !Array.isArray(raw.items)
                ? raw.items
                : raw;
            const result = {
                version: 2,
                updatedAt: Number(raw.updatedAt || 0),
                items: __hh3dPortableNormalizeItems(items)
            };
            if (fromV1) {
                try { __hh3dPortableWriteBox(result); } catch {}
            }
            return result;
        }

        if (typeof raw === 'string' && raw) {
            const parsed = JSON.parse(raw);
            if (parsed && typeof parsed === 'object') {
                const result = {
                    version: 2,
                    updatedAt: Number(parsed.updatedAt || 0),
                    items: __hh3dPortableNormalizeItems(parsed.items || parsed)
                };
                if (fromV1) {
                    try { __hh3dPortableWriteBox(result); } catch {}
                }
                return result;
            }
        }
    } catch (error) {
        console.warn('[HH3D Portable Config] Khong doc duoc kho cau hinh:', error);
    }

    return { version: 2, updatedAt: 0, items: __hh3dPortableNormalizeItems({}) };
}

function __hh3dPortableWriteBox(box) {
    const normalized = {
        version: 2,
        updatedAt: Date.now(),
        items: __hh3dPortableNormalizeItems(box?.items || {})
    };

    __hh3dGmSet(__HH3D_PORTABLE_BOX_KEY__, normalized);
    return normalized;
}

function __hh3dPortableIsSensitiveKey(key) {
    return /(?:^|[_-])(token|access[_-]?token|refresh[_-]?token|auth|authorization|session|cookie|csrf|xsrf|nonce|jwt|secret|password|passwd|credential)(?:$|[_-])/i.test(String(key || ''));
}

function __hh3dPortableIsLegacyAutoKey(key) {
    const value = String(key || '');
    return /^(?:__hh3d_|hh3d|setting|auto|hoangvuc|khoangmach|km_|favorite_mine_|luyenDan|luyendan|ld_|mc_|mecung|me_cung|dice|tienDuyen)/i.test(value);
}

function __hh3dPortableIsRuntimeKey(key) {
    const value = String(key || '');
    if (/^(?:hoangvuc_last_status|mc_auto_running|mc_wakelock_running|luyenDanNeedKeepFire)$/i.test(value)) return true;
    return /(?:^|[_-])(?:cache|last[_-]?(?:status|scan|check|request)|running|runtime|heartbeat|temporary|temp)(?:$|[_-])/i.test(value)
        && value !== '__hh3d_khoang_mach_config_v1__';
}

function __hh3dPortableCanStore(key) {
    const value = String(key ?? '').trim();
    return !!value
        && value !== __HH3D_PORTABLE_BOX_KEY__
        && value !== __HH3D_PORTABLE_OLD_BOX_KEY__
        && value !== __HH3D_RESTORE_GUARD_KEY__
        && !__hh3dPortableIsRuntimeKey(value)
        && !__hh3dPortableIsSensitiveKey(value);
}

function __hh3dPortableReadGuard() {
    const guard = __hh3dGmGet(__HH3D_RESTORE_GUARD_KEY__, null);
    if (!guard || typeof guard !== 'object') return null;
    if (Number(guard.expiresAt || 0) <= Date.now()) {
        try { if (typeof GM_deleteValue === 'function') GM_deleteValue(__HH3D_RESTORE_GUARD_KEY__); } catch {}
        return null;
    }
    if (!guard.items || typeof guard.items !== 'object') return null;

    guard.releaseAfter = guard.releaseAfter && typeof guard.releaseAfter === 'object'
        ? guard.releaseAfter
        : {};
    let changed = false;
    for (const [key, releaseAt] of Object.entries(guard.releaseAfter)) {
        if (Number(releaseAt || 0) > Date.now()) continue;
        delete guard.releaseAfter[key];
        delete guard.items[key];
        changed = true;
    }
    if (!Object.keys(guard.items).length) {
        try { if (typeof GM_deleteValue === 'function') GM_deleteValue(__HH3D_RESTORE_GUARD_KEY__); } catch {}
        return null;
    }
    if (changed) {
        try { __hh3dGmSet(__HH3D_RESTORE_GUARD_KEY__, guard); } catch {}
    }
    return guard;
}

function __hh3dPortableNativeGet(key) {
    try {
        const name = String(key);
        const value = __HH3D_NATIVE_LOCAL_STORAGE__?.getItem(name) ?? null;
        return __hh3dPortableNormalizeStoredValue(name, value);
    } catch {
        return null;
    }
}

function __hh3dPortableNativeSet(key, value) {
    try {
        const name = String(key);
        const normalized = __hh3dPortableNormalizeStoredValue(name, value);
        __HH3D_NATIVE_LOCAL_STORAGE__?.setItem(name, String(normalized));
    } catch {}
}

function __hh3dPortableNativeRemove(key) {
    try {
        __HH3D_NATIVE_LOCAL_STORAGE__?.removeItem(String(key));
    } catch {}
}

function __hh3dPortableMigrateCurrentDomain() {
    const box = __hh3dPortableReadBox();
    let changed = false;
    let migrated = 0;

    try {
        const native = __HH3D_NATIVE_LOCAL_STORAGE__;
        const length = Number(native?.length || 0);

        for (let index = 0; index < length; index++) {
            const key = native.key(index);
            if (!key || !__hh3dPortableIsLegacyAutoKey(key) || !__hh3dPortableCanStore(key)) continue;
            if (Object.prototype.hasOwnProperty.call(box.items, key)) continue;

            const value = native.getItem(key);
            if (value === null) continue;

            box.items[key] = String(value);
            changed = true;
            migrated++;
        }
    } catch (error) {
        console.warn('[HH3D Portable Config] Migration localStorage that bai:', error);
    }

    if (changed) __hh3dPortableWriteBox(box);
    if (migrated) {
        console.log(`[HH3D Portable Config] Da migrate ${migrated} key tu ${location.origin}.`);
    }
    return migrated;
}

const localStorage = {
    getItem(key) {
        const name = String(key);

        const guard = __hh3dPortableReadGuard();
        if (guard && Object.prototype.hasOwnProperty.call(guard.items, name)) {
            const guarded = String(guard.items[name]);
            __hh3dPortableNativeSet(name, guarded);
            // Sau khi module da doc cau hinh, giu them mot khoang ngan de chan
            // cac lenh gan default dong bo; sau do cho phep nguoi dung thay doi binh thuong.
            if (!guard.releaseAfter[name]) {
                guard.releaseAfter[name] = Date.now() + 1500;
                try { __hh3dGmSet(__HH3D_RESTORE_GUARD_KEY__, guard); } catch {}
            }
            return guarded;
        }

        if (__hh3dPortableCanStore(name)) {
            const box = __hh3dPortableReadBox();
            if (Object.prototype.hasOwnProperty.call(box.items, name)) {
                return String(box.items[name]);
            }
        }

        const nativeValue = __hh3dPortableNativeGet(name);

        // Facade nay chi duoc code Auto su dung: key cu duoc doc se tu dong portable.
        if (nativeValue !== null && __hh3dPortableCanStore(name)) {
            try {
                const box = __hh3dPortableReadBox();
                box.items[name] = String(nativeValue);
                __hh3dPortableWriteBox(box);
            } catch {}
        }

        return nativeValue;
    },

    setItem(key, value) {
        const name = String(key);
        let text = String(value);

        // Ngan gia tri mac dinh luc khoi dong de len cau hinh vua import.
        const guard = __hh3dPortableReadGuard();
        if (guard && Object.prototype.hasOwnProperty.call(guard.items, name)) {
            text = String(guard.items[name]);
        }

        // Mirror ve origin hien tai de code trong page realm van tuong thich.
        __hh3dPortableNativeSet(name, text);

        if (!__hh3dPortableCanStore(name)) return;
        try {
            const box = __hh3dPortableReadBox();
            box.items[name] = text;
            __hh3dPortableWriteBox(box);
        } catch (error) {
            console.warn('[HH3D Portable Config] Khong luu duoc key:', name, error);
        }
    },

    removeItem(key) {
        const name = String(key);
        const guard = __hh3dPortableReadGuard();
        if (guard && Object.prototype.hasOwnProperty.call(guard.items, name)) {
            __hh3dPortableNativeSet(name, String(guard.items[name]));
            return;
        }
        __hh3dPortableNativeRemove(name);

        if (!__hh3dPortableCanStore(name)) return;
        try {
            const box = __hh3dPortableReadBox();
            if (Object.prototype.hasOwnProperty.call(box.items, name)) {
                delete box.items[name];
                __hh3dPortableWriteBox(box);
            }
        } catch {}
    },

    clear() {
        try {
            __HH3D_NATIVE_LOCAL_STORAGE__?.clear();
        } catch {}
        try {
            if (typeof GM_deleteValue === 'function') GM_deleteValue(__HH3D_PORTABLE_BOX_KEY__);
            else __hh3dPortableWriteBox({ items: {} });
            if (typeof GM_deleteValue === 'function') GM_deleteValue(__HH3D_PORTABLE_OLD_BOX_KEY__);
            if (typeof GM_deleteValue === 'function') GM_deleteValue(__HH3D_RESTORE_GUARD_KEY__);
        } catch {}
    },

    key(index) {
        const keys = [];
        const seen = new Set();

        try {
            const native = __HH3D_NATIVE_LOCAL_STORAGE__;
            for (let i = 0; i < Number(native?.length || 0); i++) {
                const key = native.key(i);
                if (key !== null && !seen.has(key)) {
                    seen.add(key);
                    keys.push(key);
                }
            }
        } catch {}

        try {
            const box = __hh3dPortableReadBox();
            for (const key of Object.keys(box.items)) {
                if (!seen.has(key)) {
                    seen.add(key);
                    keys.push(key);
                }
            }
        } catch {}

        return keys[Number(index)] ?? null;
    },

    get length() {
        let count = 0;
        while (this.key(count) !== null) count++;
        return count;
    }
};

function __hh3dPortableExportObject() {
    const box = __hh3dPortableReadBox();
    // Bo sung key cu tu domain hien tai, ke ca nhung module chua duoc mo trong phien nay.
    try {
        const native = __HH3D_NATIVE_LOCAL_STORAGE__;
        for (let i = 0; i < Number(native?.length || 0); i++) {
            const key = native.key(i);
            if (!key || !__hh3dPortableIsLegacyAutoKey(key) || !__hh3dPortableCanStore(key)) continue;
            const value = native.getItem(key);
            if (value !== null) box.items[key] = String(value);
        }
    } catch {}
    const items = Object.fromEntries(Object.entries(__hh3dPortableNormalizeItems(box.items)).filter(([key]) => __hh3dPortableCanStore(key)));
    return {
        format: __HH3D_PORTABLE_FORMAT__,
        version: 2,
        scriptVersion: '7.4.34',
        exportedAt: new Date().toISOString(),
        modules: __hh3dPortableModuleReport(items),
        items
    };
}

function __hh3dPortableModuleReport(items) {
    const keys = Object.keys(items || {});
    const count = (re) => keys.filter(key => re.test(key)).length;
    return {
        hoangVuc: count(/^hoangvuc/i),
        khoangMach: count(/^(?:__hh3d_khoang_mach_|khoangmach|km_|favorite_mine_)/i),
        luyenDan: count(/^(?:autoLuyenDan|luyenDan|luyendan|ld_|__hh3d_luyendan_)/i),
        meCung: count(/^(?:mc_|mecung|me_cung)/i)
    };
}

function __hh3dPortableDownload() {
    const data = JSON.stringify(__hh3dPortableExportObject(), null, 2);
    const blob = new Blob([data], { type: 'application/json;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    const stamp = new Date().toISOString().replace(/[:.]/g, '-');
    link.href = url;
    link.download = `hh3d-config-${stamp}.json`;
    document.documentElement.appendChild(link);
    link.click();
    link.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
}

async function __hh3dPortableDetectUid() {
    for (let attempt = 0; attempt < 40; attempt++) {
        try {
            const w = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
            const data = w.hh3dData || {};
            const value = data.user_id ?? data.uid ?? data.current_user_id ?? data.user?.id ??
                data.user?.user_id ?? w.current_user_id ?? w.user_id;
            if (value !== undefined && value !== null && String(value).trim()) return String(value).trim();
        } catch {}
        await new Promise(resolve => setTimeout(resolve, 100));
    }
    return '';
}

function __hh3dPortableRebindUidKey(key, currentUid) {
    if (!currentUid) return key;
    const patterns = [
        /^(luyenDanInputValue)_\d+$/i,
        /^(tienDuyenInputValue)_\d+$/i,
        /^(khoangmach_selected_mine)_\d+$/i,
        /^(khoangmach_leave_mine_to_claim_reward)_\d+$/i
    ];
    for (const pattern of patterns) {
        const match = String(key).match(pattern);
        if (match) return `${match[1]}_${currentUid}`;
    }
    return key;
}

async function __hh3dPortableImport(input, replace = false) {
    const parsed = typeof input === 'string' ? JSON.parse(input) : input;
    if (!parsed || typeof parsed !== 'object') throw new Error('Du lieu cau hinh khong hop le');
    if (parsed.format && parsed.format !== __HH3D_PORTABLE_FORMAT__) {
        throw new Error('Khong dung dinh dang cau hinh HH3D');
    }

    const source = parsed.items && typeof parsed.items === 'object' ? parsed.items : parsed;
    const currentUid = await __hh3dPortableDetectUid();
    const box = replace ? { version: 2, updatedAt: 0, items: {} } : __hh3dPortableReadBox();
    const restored = {};
    let imported = 0;

    for (const [key, value] of Object.entries(source)) {
        const targetKey = __hh3dPortableRebindUidKey(key, currentUid);
        if (!__hh3dPortableCanStore(targetKey)) continue;
        if (value === undefined || value === null) continue;
        const rawText = typeof value === 'string' ? value : JSON.stringify(value);
        const text = String(__hh3dPortableNormalizeStoredValue(targetKey, rawText));
        box.items[targetKey] = text;
        restored[targetKey] = text;
        __hh3dPortableNativeSet(targetKey, text);
        imported++;
    }

    const written = __hh3dPortableWriteBox(box);
    const settingsValue = String(__hh3dPortableNormalizeStoredValue(
        __HH3D_LOCAL_SETTINGS_V2_KEY__,
        written.items[__HH3D_LOCAL_SETTINGS_V2_KEY__]
            ?? __hh3dPortableNativeGet(__HH3D_LOCAL_SETTINGS_V2_KEY__)
            ?? '{}'
    ));
    written.items[__HH3D_LOCAL_SETTINGS_V2_KEY__] = settingsValue;
    written.items[__HH3D_HOANG_VUC_FORCE_KEY__] = 'true';
    __hh3dPortableWriteBox(written);
    for (const forcedKey of [__HH3D_HOANG_VUC_FORCE_KEY__, __HH3D_LOCAL_SETTINGS_V2_KEY__]) {
        const forcedValue = String(written.items[forcedKey]);
        restored[forcedKey] = forcedValue;
        __hh3dPortableNativeSet(forcedKey, forcedValue);
    }
    __hh3dGmSet(__HH3D_RESTORE_GUARD_KEY__, {
        createdAt: Date.now(),
        expiresAt: Date.now() + 30000,
        releaseAfter: {},
        items: restored
    });
    return { imported, currentUid, modules: __hh3dPortableModuleReport(restored) };
}

function __hh3dPortableOpenImportDialog() {
    const old = document.getElementById('__hh3d_portable_import_dialog__');
    if (old) {
        try { old.querySelector('input[type="file"]')?.focus(); } catch {}
        return;
    }

    const root = document.body || document.documentElement;
    if (!root) throw new Error('Trang chua san sang. Hay thu lai sau khi trang tai xong.');

    const overlay = document.createElement('div');
    overlay.id = '__hh3d_portable_import_dialog__';
    Object.assign(overlay.style, {
        position: 'fixed', inset: '0', zIndex: '2147483647',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        padding: '16px', boxSizing: 'border-box',
        background: 'rgba(0,0,0,.72)', fontFamily: 'Arial,sans-serif'
    });

    const card = document.createElement('div');
    Object.assign(card.style, {
        width: 'min(620px,100%)', maxHeight: '90vh', overflow: 'auto',
        padding: '20px', borderRadius: '12px', boxSizing: 'border-box',
        color: '#f5f5f5', background: '#242424', border: '1px solid #555',
        boxShadow: '0 16px 48px rgba(0,0,0,.55)'
    });

    const title = document.createElement('div');
    title.textContent = 'Nhập cấu hình HH3D';
    Object.assign(title.style, { fontSize: '20px', fontWeight: '700', marginBottom: '8px' });

    const help = document.createElement('div');
    help.textContent = 'Chọn file JSON đã xuất hoặc dán trực tiếp nội dung JSON vào ô bên dưới.';
    Object.assign(help.style, { fontSize: '14px', lineHeight: '1.5', color: '#ccc', marginBottom: '12px' });

    const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = '.json,application/json,text/json';
    Object.assign(fileInput.style, {
        display: 'block', width: '100%', marginBottom: '12px', padding: '10px',
        boxSizing: 'border-box', color: '#fff', background: '#333',
        border: '1px solid #666', borderRadius: '8px', cursor: 'pointer'
    });

    const textarea = document.createElement('textarea');
    textarea.placeholder = 'Hoặc dán nội dung hh3d-config-....json vào đây';
    Object.assign(textarea.style, {
        display: 'block', width: '100%', minHeight: '180px', resize: 'vertical',
        padding: '10px', boxSizing: 'border-box', color: '#eee', background: '#161616',
        border: '1px solid #666', borderRadius: '8px', font: '12px/1.45 monospace'
    });

    const status = document.createElement('div');
    Object.assign(status.style, { minHeight: '22px', marginTop: '10px', fontSize: '13px', lineHeight: '1.45' });

    const actions = document.createElement('div');
    Object.assign(actions.style, { display: 'flex', justifyContent: 'flex-end', gap: '10px', marginTop: '10px' });
    const cancelButton = document.createElement('button');
    cancelButton.type = 'button';
    cancelButton.textContent = 'Hủy';
    const importButton = document.createElement('button');
    importButton.type = 'button';
    importButton.textContent = 'Nhập cấu hình';
    for (const button of [cancelButton, importButton]) {
        Object.assign(button.style, {
            padding: '10px 16px', border: '0', borderRadius: '8px',
            color: '#fff', cursor: 'pointer', fontSize: '14px', fontWeight: '700'
        });
    }
    cancelButton.style.background = '#555';
    importButton.style.background = '#1677ff';

    const close = () => overlay.remove();
    cancelButton.addEventListener('click', close);
    overlay.addEventListener('click', event => { if (event.target === overlay) close(); });
    fileInput.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        try {
            textarea.value = await file.text();
            status.style.color = '#8ee68e';
            status.textContent = `Đã đọc ${file.name} (${textarea.value.length.toLocaleString()} ký tự).`;
        } catch (error) {
            status.style.color = '#ff8f8f';
            status.textContent = `Không đọc được file: ${error.message || error}`;
        }
    });
    importButton.addEventListener('click', async () => {
        const text = textarea.value.trim();
        if (!text) {
            status.style.color = '#ffd36a';
            status.textContent = 'Hãy chọn file JSON hoặc dán nội dung cấu hình trước.';
            return;
        }

        importButton.disabled = true;
        cancelButton.disabled = true;
        importButton.style.opacity = '.65';
        status.style.color = '#9dc8ff';
        status.textContent = 'Đang kiểm tra và nhập cấu hình...';
        try {
            const result = await __hh3dPortableImport(text, false);
            const m = result.modules;
            status.style.color = '#8ee68e';
            status.textContent = `Đã nhập ${result.imported} mục — Hoang Vực: ${m.hoangVuc}, Khoáng Mạch: ${m.khoangMach}, Luyện Đan: ${m.luyenDan}, Mê Cung: ${m.meCung}. Đang tải lại trang...`;
            setTimeout(() => location.reload(), 1200);
        } catch (error) {
            status.style.color = '#ff8f8f';
            status.textContent = `Nhập thất bại: ${error.message || error}`;
            importButton.disabled = false;
            cancelButton.disabled = false;
            importButton.style.opacity = '1';
        }
    });

    actions.append(cancelButton, importButton);
