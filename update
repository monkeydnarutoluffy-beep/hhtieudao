            savedAt: Date.now(),
            source: GOOGLE_DOC_SOURCE,
            questionCount: Object.keys(data.questions).length,
            data
        });
        return data;
    };
    const gmGet = url => new Promise((resolve, reject) => {
        if (typeof GM_xmlhttpRequest !== 'function') return reject(new Error('GM_xmlhttpRequest khong kha dung'));
        GM_xmlhttpRequest({
            method: 'GET', url, timeout: 15000,
            onload: response => response.status >= 200 && response.status < 300
                ? resolve(response.responseText)
                : reject(new Error(`HTTP ${response.status}`)),
            onerror: () => reject(new Error('Loi mang')),
            ontimeout: () => reject(new Error('Qua thoi gian'))
        });
    });
    const response = (data, source) => new Response(JSON.stringify(data), {
        status: 200,
        headers: {
            'Content-Type': 'application/json; charset=utf-8',
            'X-HH3D-Answer-Source': source,
            'X-HH3D-Question-Count': String(Object.keys(data.questions).length)
        }
    });

    const refreshFromGoogleDocs = async () => save(parse(await gmGet(GOOGLE_DOC_SOURCE)));

    globalThis.fetch = async function hh3dFetch(input, init) {
        const url = typeof input === 'string' ? input : input?.url;
        if (!url || String(url).split('?')[0].replace(/\/$/, '') !== LEGACY_SOURCE) return originalFetch(input, init);

        const local = cached();
        if (local) {
            // Tra cache ngay de giao dien khong phai cho; cap nhat Docs o nen cho lan sau.
            refreshFromGoogleDocs().catch(error =>
                console.warn('[HH3D Van Dap] Google Docs tam thoi khong truy cap duoc, dang dung cache:', error)
            );
            return response(local, 'google-docs-cache');
        }

        try {
            return response(await refreshFromGoogleDocs(), 'google-docs-live');
        } catch (error) {
            // Du lieu nhung da duoc xac thuc khi build: lan cai dau van hoat dong offline.
            console.warn('[HH3D Van Dap] Google Docs tam thoi khong truy cap duoc, dang dung du lieu nhung:', error);
            try { save(EMBEDDED_DATA); } catch {}
            return response(EMBEDDED_DATA, 'embedded-fallback');
        }
    };
})();


/* ===== HH3D v7.4.30 - Mê Cung: persist "Hiện chi tiết trận đánh" ===== */
(() => {
    'use strict';
    const KEY = 'mc_show_combat';
    const SETTINGS_BOX_KEY = '__hh3d_local_settings_v2__';
    const BOUND_ATTR = 'data-hh3d-mc-show-combat-bound';
    let syncing = false;
    let scanTimer = null;

    const normalizeText = value => String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/đ/g, 'd')
        .replace(/Đ/g, 'D')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

    function parseFlag(value, fallback = null) {
        if (typeof value === 'boolean') return value;
        if (value === undefined || value === null) return fallback;
        const text = String(value).trim().toLowerCase();
        if (['1', 'true', 'yes', 'on', 'checked'].includes(text)) return true;
        if (['0', 'false', 'no', 'off', 'unchecked', ''].includes(text)) return false;
        return fallback;
    }

    function readSaved() {
        try {
            const direct = localStorage.getItem(KEY);
            if (direct !== null) {
                const parsed = parseFlag(direct, null);
                if (parsed !== null) return parsed;
            }
        } catch {}

        try {
            const raw = localStorage.getItem(SETTINGS_BOX_KEY);
            if (!raw) return null;
            const box = JSON.parse(raw);
            return parseFlag(box?.[KEY], null);
        } catch {
            return null;
        }
    }

    function save(value) {
        const checked = !!value;
        try { localStorage.setItem(KEY, String(checked)); } catch {}
        try {
            const raw = localStorage.getItem(SETTINGS_BOX_KEY);
            const box = raw ? JSON.parse(raw) : {};
            const normalized = box && typeof box === 'object' && !Array.isArray(box) ? box : {};
            normalized[KEY] = checked;
            localStorage.setItem(SETTINGS_BOX_KEY, JSON.stringify(normalized));
        } catch {}
        return checked;
    }

    function getCheckboxText(input) {
        const parts = [];
        try {
            const label = input.closest('label');
            if (label) parts.push(label.textContent || '');
            if (input.id) {
                const safeId = window.CSS?.escape ? CSS.escape(input.id) : input.id.replace(/(["\\])/g, '\\$1');
                const byFor = document.querySelector(`label[for="${safeId}"]`);
                if (byFor) parts.push(byFor.textContent || '');
            }
            if (input.parentElement) parts.push(input.parentElement.textContent || '');
        } catch {}
        return normalizeText(parts.join(' '));
    }

    function findCheckbox() {
        const inputs = [...document.querySelectorAll('input[type="checkbox"]')];
        return inputs.find(input => {
            const idName = normalizeText(`${input.id || ''} ${input.name || ''}`);
            if (/mc.*show.*combat|show.*combat/.test(idName)) return true;
            return getCheckboxText(input).includes('hien chi tiet tran danh');
        }) || null;
    }

    function fire(input, type) {
        try { input.dispatchEvent(new Event(type, { bubbles: true })); } catch {}
    }

    function restore(input, reason = '') {
        if (!input || !document.documentElement.contains(input)) return;
        const saved = readSaved();
        if (saved === null) {
            // Lan dau chua co cau hinh: lay dung trang thai UI lam baseline.
            save(input.checked);
            return;
        }

        syncing = true;
        try {
            if (input.checked !== saved) {
                input.checked = saved;
                fire(input, 'input');
                fire(input, 'change');
                console.log(`[Me Cung Config] Da khoi phuc "Hien chi tiet tran danh" = ${saved}${reason ? ` (${reason})` : ''}.`);
            } else if (reason === 'retry-3') {
                // Dong bo bien runtime sau khi listener goc da duoc gan.
                fire(input, 'change');
            }
        } finally {
            syncing = false;
        }
    }

    function bind(input) {
        if (!input || input.getAttribute(BOUND_ATTR) === '1') return;
        input.setAttribute(BOUND_ATTR, '1');
        input.addEventListener('change', () => {
            if (syncing) return;
            save(input.checked);
            console.log(`[Me Cung Config] Da luu "Hien chi tiet tran danh" = ${!!input.checked}.`);
        }, true);

        [0, 80, 300, 800, 1800, 3500, 6000, 10000].forEach((ms, index) => {
            setTimeout(() => restore(input, `retry-${index}`), ms);
        });
    }

    function scan() {
        scanTimer = null;
        const input = findCheckbox();
        if (input) bind(input);
    }

    function scheduleScan() {
        if (scanTimer) return;
        scanTimer = setTimeout(scan, 50);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleScan, { once: true });
    } else {
        scheduleScan();
    }

    const observer = new MutationObserver(scheduleScan);
    observer.observe(document.documentElement || document, { childList: true, subtree: true });
})();


/* ===== HH3D Khoang Mach Local Persistence =====
 * Luu/khôi phuc TOAN BO input/select/checkbox trong bang cau hinh Khoang Mach
 * bang 1 object localStorage duy nhat. Khong phu thuoc UID/Google Sheets.
 */
(() => {
    'use strict';

    const STORAGE_KEY = '__hh3d_khoang_mach_config_v1__';
    const BOUND_ATTR = 'data-hh3d-km-local-bound';
    let panel = null;
    let restoring = false;
    let scanTimer = null;
    let restoreTimers = [];

    const norm = (v) => String(v ?? '')
        .replace(/\s+/g, ' ')
        .trim();

    function loadConfig() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            const cfg = JSON.parse(raw);
            return cfg && Array.isArray(cfg.controls) ? cfg : null;
        } catch (e) {
            console.warn('[KhoangMach Local] Khong doc duoc cau hinh:', e);
            return null;
        }
    }

    function getLabel(el) {
        try {
            if (el.id) {
                const safeId = (window.CSS && CSS.escape)
                    ? CSS.escape(el.id)
                    : el.id.replace(/(["\\])/g, '\\$1');
                const byFor = document.querySelector(`label[for="${safeId}"]`);
                if (byFor) {
                    const t = norm(byFor.textContent);
                    if (t) return t.slice(0, 120);
                }
            }

            const ownLabel = el.closest && el.closest('label');
            if (ownLabel) {
                const t = norm(ownLabel.textContent);
                if (t) return t.slice(0, 120);
            }

            let prev = el.previousElementSibling;
            for (let i = 0; prev && i < 3; i++, prev = prev.previousElementSibling) {
                const t = norm(prev.textContent);
                if (t && t.length <= 120) return t;
            }

            const parent = el.parentElement;
            if (parent) {
                const t = norm(parent.textContent);
                if (t && t.length <= 140) return t;
            }
        } catch {}
        return '';
    }

    function getControls(root) {
        return [...root.querySelectorAll('input, select, textarea')].filter(el => {
            if (el.disabled) return false;
            if (el.tagName === 'INPUT') {
                const type = String(el.type || 'text').toLowerCase();
                if (['hidden', 'button', 'submit', 'reset', 'file', 'image'].includes(type)) return false;
            }
            return true;
        });
    }

    function keyOf(el, index) {
        const tag = String(el.tagName || '').toLowerCase();
        const type = tag === 'input' ? String(el.type || 'text').toLowerCase() : tag;
        const id = norm(el.id);
        const name = norm(el.getAttribute('name'));
        const placeholder = norm(el.getAttribute('placeholder'));
        const label = getLabel(el);
        return [
            tag,
            type,
            id ? `id=${id}` : '',
            name ? `name=${name}` : '',
            placeholder ? `ph=${placeholder}` : '',
            label ? `label=${label}` : '',
            `idx=${index}`
        ].filter(Boolean).join('|');
    }

    function snapshot(root) {
        const controls = getControls(root);
        return {
            version: 1,
            savedAt: Date.now(),
            controls: controls.map((el, index) => {
                const tag = el.tagName.toLowerCase();
                const type = tag === 'input' ? String(el.type || 'text').toLowerCase() : tag;
                const item = {
                    key: keyOf(el, index),
                    index,
                    tag,
                    type
                };

                if (type === 'checkbox' || type === 'radio') {
                    item.checked = !!el.checked;
                } else {
                    item.value = el.value;
                }
                return item;
            })
        };
    }

    function saveNow() {
        if (!panel || restoring || !document.documentElement.contains(panel)) return;
        try {
            const cfg = snapshot(panel);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(cfg));
            // Marker rieng de debug nhanh trong Application -> Local Storage.
            localStorage.setItem('__hh3d_khoang_mach_config_saved_at__', String(cfg.savedAt));
        } catch (e) {
            console.warn('[KhoangMach Local] Luu that bai:', e);
        }
    }

    function fire(el, type) {
        try {
            el.dispatchEvent(new Event(type, { bubbles: true }));
        } catch {}
    }

    function restoreNow(root, reason = '') {
        const cfg = loadConfig();
        if (!cfg || !cfg.controls.length || !root || !document.documentElement.contains(root)) return false;

        const controls = getControls(root);
        const byKey = new Map(cfg.controls.map(x => [x.key, x]));
        let changedCount = 0;

        restoring = true;
        try {
            controls.forEach((el, index) => {
                const key = keyOf(el, index);
                let saved = byKey.get(key);

                // Fallback theo vi tri + loai control de chiu duoc ID/name thay doi.
                if (!saved) {
                    const candidate = cfg.controls[index];
                    if (candidate) {
                        const tag = el.tagName.toLowerCase();
                        const type = tag === 'input' ? String(el.type || 'text').toLowerCase() : tag;
                        if (candidate.tag === tag && candidate.type === type) saved = candidate;
                    }
                }
                if (!saved) return;

                const tag = el.tagName.toLowerCase();
                const type = tag === 'input' ? String(el.type || 'text').toLowerCase() : tag;
                let changed = false;

                if (type === 'checkbox' || type === 'radio') {
                    const wanted = !!saved.checked;
                    if (el.checked !== wanted) {
                        el.checked = wanted;
                        changed = true;
                    }
                } else if (Object.prototype.hasOwnProperty.call(saved, 'value')) {
                    const wanted = String(saved.value ?? '');

                    // Select co the duoc nap options cham; neu option chua co thi de lan retry sau xu ly.
                    if (tag === 'select' && wanted !== '' &&
                        ![...el.options].some(o => String(o.value) === wanted)) {
                        return;
                    }

                    if (String(el.value) !== wanted) {
                        el.value = wanted;
                        changed = true;
                    }
                }

                const labelText = getLabel(el);
                const isMineSelector = tag === 'select' && (
                    String(el.id || '').toLowerCase() === 'specificmineselect' ||
                    labelText.includes('Chọn Khoáng Mạch') ||
                    labelText.includes('Chon Khoang Mach')
                );

                if (changed) {
                    changedCount++;
                    // Cap nhat bien runtime cua code goc ma khong can Google Sheets.
                    fire(el, 'input');
                    fire(el, 'change');
                } else if (isMineSelector && Object.prototype.hasOwnProperty.call(saved, 'value')) {
                    /*
                     * FIX v7.4.14:
                     * Sau F5, persistence co the da gan value vao <select> truoc khi
                     * module Khoang Mach hoan tat khoi tao minesData / listener.
                     * Cac retry sau thay value da dung nen v7.4.13 khong phat change nua.
                     * Ket qua: UI hien dung ten mo, nhung key nghiep vu
                     * khoangmach_selected_mine_<accountId> chua duoc tao -> doKhoangMach
                     * bao "Ban chua chon mo".
                     *
                     * O cac retry muon, phat lai change cho RIENG select Chon Khoang Mach
                     * de code goc tu tao lai {id,type} vao key nghiep vu.
                     */
                    const wanted = String(saved.value ?? '');
                    const hasWantedOption = wanted === '' ||
                        [...el.options].some(o => String(o.value) === wanted);

                    if (hasWantedOption && /^retry-(?:3|5|6|7|8|9)$/.test(reason)) {
                        fire(el, 'change');
                    }
                }
            });
        } finally {
            restoring = false;
        }

        if (changedCount) {
            console.log(`[KhoangMach Local] Da khoi phuc ${changedCount} gia tri${reason ? ` (${reason})` : ''}.`);
        }
        return changedCount > 0;
    }

    function looksLikeKhoangMachPanel(el) {
        if (!el || el.nodeType !== 1) return false;
        const text = norm(el.textContent);
        if (!text.includes('Chọn Khoáng Mạch') && !text.includes('Chon Khoang Mach')) return false;
        if (!text.includes('Chế độ Nhận Thưởng') && !text.includes('Che do Nhan Thuong')) return false;
        return getControls(el).length >= 5;
    }

    function findPanel() {
        const nodes = [...document.querySelectorAll('div, section, form')];
        let best = null;
        let bestControls = Infinity;
        let bestTextLen = Infinity;

        for (const el of nodes) {
            if (!looksLikeKhoangMachPanel(el)) continue;

            const count = getControls(el).length;
            const len = norm(el.textContent).length;

            // Chon container nho nhat chua tron bang cau hinh, tranh lay ca sidebar.
            if (count < bestControls || (count === bestControls && len < bestTextLen)) {
                best = el;
                bestControls = count;
                bestTextLen = len;
            }
        }
        return best;
    }

    function clearRestoreTimers() {
        for (const t of restoreTimers) clearTimeout(t);
        restoreTimers = [];
    }

    function scheduleRestores(root) {
        clearRestoreTimers();
        [0, 80, 250, 700, 1500, 3000, 5000, 8000, 12000, 20000].forEach((ms, n) => {
            restoreTimers.push(setTimeout(() => restoreNow(root, `retry-${n}`), ms));
        });
    }

    function bind(root) {
        if (!root || root.getAttribute(BOUND_ATTR) === '1') return;

        if (panel && panel !== root && document.documentElement.contains(panel)) {
            try { saveNow(); } catch {}
        }

        panel = root;
        root.setAttribute(BOUND_ATTR, '1');

        const onUserChange = (ev) => {
            if (restoring) return;
            if (!ev.target || !ev.target.matches('input,select,textarea')) return;
            setTimeout(saveNow, 0);
        };

        root.addEventListener('change', onUserChange, true);
        root.addEventListener('input', onUserChange, true);

        // Neu da co config local: local la source of truth.
        // Neu chua co config: luu trang thai UI hien tai de tao baseline.
        if (loadConfig()) {
            scheduleRestores(root);
        } else {
            setTimeout(saveNow, 250);
        }

        console.log('[KhoangMach Local] Persistence da gan. Storage:', STORAGE_KEY);
    }

    function scan() {
        scanTimer = null;
        const found = findPanel();
        if (found) bind(found);
    }

    function scheduleScan() {
        if (scanTimer) return;
        scanTimer = setTimeout(scan, 80);
    }

    // Khoi dong tu document-start va bat moi lan UI bi render lai.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleScan, { once: true });
    } else {
        scheduleScan();
    }

    const mo = new MutationObserver(scheduleScan);
    mo.observe(document.documentElement || document, { childList: true, subtree: true });

    window.addEventListener('beforeunload', () => {
        try { saveNow(); } catch {}
    });

    // Debug helper khong tao request:
    // unsafeWindow.hh3dKhoangMachLocal.dump()
    // unsafeWindow.hh3dKhoangMachLocal.clear()
    try {
        const w = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
        w.hh3dKhoangMachLocal = {
            storageKey: STORAGE_KEY,
            dump: () => loadConfig(),
            save: () => saveNow(),
            restore: () => panel ? restoreNow(panel, 'manual') : false,
            clear: () => {
                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem('__hh3d_khoang_mach_config_saved_at__');
                console.log('[KhoangMach Local] Da xoa cau hinh local Khoang Mach.');
            }
        };
    } catch {}
})();


/* ===== HH3D Luyen Dan - Thue Tieu Viem Local Persistence =====
 * Muc tieu:
 * - Ghi nho checkbox "Thue Tieu Viem (Bo qua moi dan dong)" sau F5.
 * - Khong phu thuoc Google Script / UID request.
 * - Khi UI Luyen Dan duoc tao lai, khoi phuc checkbox va dong bo 1 lan
 *   voi listener goc de Auto hieu trang thai da chon.
 */
(() => {
    'use strict';

    const STORAGE_KEY = '__hh3d_luyendan_hire_tieuviem_v1__';
    const COMPAT_ENABLED_KEY = 'ld_hire_tieu_viem_enabled';
    const COMPAT_NEXT_KEY = 'ld_hire_tieu_viem_next_craft';

    let activeCheckbox = null;
    let restoreTimers = [];
    let scanTimer = null;
    const syncedElements = new WeakSet();

    const normalize = (value) => String(value ?? '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

    function readSaved() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw !== null) {
                const parsed = JSON.parse(raw);
                if (parsed && typeof parsed.enabled === 'boolean') return parsed.enabled;
            }
        } catch {}

        // Tu dong migrate neu tung co key cua module Luyen Dan doc lap.
        try {
            const legacy = localStorage.getItem(COMPAT_ENABLED_KEY);
            const next = localStorage.getItem(COMPAT_NEXT_KEY);
            if (legacy === 'true' || next === 'true') return true;
            if (legacy === 'false' && next === 'false') return false;
        } catch {}

        return null;
    }

    function mirrorCompatKeys(enabled) {
        try {
            localStorage.setItem(COMPAT_ENABLED_KEY, enabled ? 'true' : 'false');
            localStorage.setItem(COMPAT_NEXT_KEY, enabled ? 'true' : 'false');
        } catch {}
    }

    function save(enabled) {
        try {
            const value = !!enabled;
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                version: 1,
                enabled: value,
                savedAt: Date.now()
            }));
            mirrorCompatKeys(value);
        } catch (error) {
            console.warn('[LuyenDan Local] Khong luu duoc Thue Tieu Viem:', error);
        }
    }

    // Neu da co cau hinh tu phien truoc, mirror ngay tu document-start de
    // module Luyen Dan goc co the doc localStorage ngay trong luc khoi tao.
    const bootSaved = readSaved();
    if (bootSaved !== null) mirrorCompatKeys(bootSaved);

    function getLabelText(el) {
        try {
            const parts = [];

            if (el.id) {
                const esc = window.CSS?.escape ? CSS.escape(el.id) : el.id.replace(/(["\\])/g, '\\$1');
                const label = document.querySelector(`label[for="${esc}"]`);
                if (label) parts.push(label.textContent || '');
            }

            const parentLabel = el.closest?.('label');
            if (parentLabel) parts.push(parentLabel.textContent || '');

            let p = el.parentElement;
            for (let i = 0; p && i < 3; i++, p = p.parentElement) {
                parts.push(p.textContent || '');
            }

            return normalize(parts.join(' '));
        } catch {
            return '';
        }
    }

    function isHireTieuViemCheckbox(el) {
        if (!el || el.tagName !== 'INPUT' || String(el.type).toLowerCase() !== 'checkbox') return false;

        const id = normalize(el.id);
        const name = normalize(el.getAttribute('name'));
        if (
            id.includes('hire-tieu-viem') ||
            id.includes('hire_tieu_viem') ||
            name.includes('hire-tieu-viem') ||
            name.includes('hire_tieu_viem')
        ) return true;

        const text = getLabelText(el);
        return text.includes('thue tieu viem')
            && (
                text.includes('bo qua moi dan dong')
                || text.includes('dan dong')
                || text.includes('tieu viem')
            );
    }

    function findCheckbox() {
        const known = document.querySelector(
            '#ld-hire-tieu-viem-check, input[name*="hire_tieu_viem"], input[id*="hire-tieu-viem"], input[id*="hire_tieu_viem"]'
        );
        if (isHireTieuViemCheckbox(known)) return known;

        return [...document.querySelectorAll('input[type="checkbox"]')]
            .find(isHireTieuViemCheckbox) || null;
    }

    function fire(el, type) {
        try {
            el.dispatchEvent(new Event(type, { bubbles: true }));
        } catch {}
    }

    function clearRestoreTimers() {
        for (const timer of restoreTimers) clearTimeout(timer);
        restoreTimers = [];
    }

    function restoreElement(el, reason = '') {
        if (!el || !document.documentElement.contains(el)) return false;

        const saved = readSaved();
        if (saved === null) return false;

        mirrorCompatKeys(saved);

        const changed = el.checked !== saved;
        if (changed) el.checked = saved;

        /*
         * Dong bo VOI LISTENER GOC mot lan cho moi instance checkbox.
         * Delay restore duoc thuc hien sau khi UI da gan event listener.
         * Event nay la phan quan trong: khong chi hien tick, ma Auto goc
         * se nhan trang thai va su dung lua chon khi Khai hoa.
         */
        if (!syncedElements.has(el)) {
            syncedElements.add(el);
            fire(el, 'input');
            fire(el, 'change');
            console.log(
                `[LuyenDan Local] Da khoi phuc Thue Tieu Viem=${saved ? 'BAT' : 'TAT'}${reason ? ` (${reason})` : ''}.`
            );
        }

        return true;
    }

    function scheduleRestore(el) {
        clearRestoreTimers();

        // Cho script goc thoi gian tao xong UI + listener. Neu UI bi render lai,
        // MutationObserver se bind instance moi va dong bo lai dung 1 lan.
        [350, 900, 1800].forEach((ms, index) => {
            restoreTimers.push(setTimeout(() => {
                if (!document.documentElement.contains(el)) return;

                const saved = readSaved();
                if (saved === null) return;

                // Retry som chi set checked de tranh event lap.
                if (el.checked !== saved) el.checked = saved;
                mirrorCompatKeys(saved);

                // Chi phat event sync tai retry cuoi, 1 lan / element.
                if (index === 2) restoreElement(el, 'startup-sync');
            }, ms));
        });
    }

    function bind(el) {
        if (!el || el === activeCheckbox) return;
        activeCheckbox = el;

        // Capture listener luu lua chon NGAY khi nguoi dung tick/bo tick.
        // Listener goc cua tool van tiep tuc nhan event binh thuong.
        el.addEventListener('change', (event) => {
            // Synthetic restore event: gia tri da duoc save tu truoc, khong can ghi lai.
            if (!event.isTrusted && syncedElements.has(el)) return;

            save(el.checked);
            console.log(`[LuyenDan Local] Thue Tieu Viem: ${el.checked ? 'BAT' : 'TAT'} - da luu localStorage.`);
        }, true);

        const saved = readSaved();
        if (saved === null) {
            // Lan dau: khong tu y thay doi checkbox. Chi bat dau ghi nho sau khi user thao tac.
            return;
        }

        scheduleRestore(el);
    }

    function scan() {
        scanTimer = null;
        const el = findCheckbox();
        if (el) bind(el);
    }

    function scheduleScan() {
        if (scanTimer) return;
        scanTimer = setTimeout(scan, 100);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', scheduleScan, { once: true });
    } else {
        scheduleScan();
    }

    const observer = new MutationObserver(scheduleScan);
    observer.observe(document.documentElement || document, {
        childList: true,
        subtree: true
    });

    // Debug helper, khong tao request.
    try {
        const w = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
        w.hh3dLuyenDanTieuViemLocal = {
            get: () => readSaved(),
            set: (enabled) => {
                save(!!enabled);
                const el = findCheckbox();
                if (el) {
                    syncedElements.delete(el);
                    scheduleRestore(el);
                }
                return !!enabled;
            },
            clear: () => {
                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem(COMPAT_ENABLED_KEY);
                localStorage.removeItem(COMPAT_NEXT_KEY);
            },
            storageKey: STORAGE_KEY
        };
    } catch {}
})();


/* ===== HH3D Luyen Dan - Inject Thue Tieu Viem vao API Khai Hoa =====
 * Khi checkbox Thuê Tiêu Viêm đang BẬT:
 *   POST .../luyen-dan/start
 * se duoc giu nguyen payload hien tai va bo sung:
 *   hire_dan_dong: true
 *
 * Khong tao request moi, chi sua payload cua chinh request Khai hoa.
 */
(() => {
    'use strict';

    const STORAGE_KEY = '__hh3d_luyendan_hire_tieuviem_v1__';
    const COMPAT_ENABLED_KEY = 'ld_hire_tieu_viem_enabled';
    const COMPAT_NEXT_KEY = 'ld_hire_tieu_viem_next_craft';

    function hireEnabled() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (raw !== null) {
                const cfg = JSON.parse(raw);
                if (cfg && typeof cfg.enabled === 'boolean') return cfg.enabled;
            }
        } catch {}

        try {
            return localStorage.getItem(COMPAT_ENABLED_KEY) === 'true'
                || localStorage.getItem(COMPAT_NEXT_KEY) === 'true';
        } catch {
            return false;
        }
    }

    function isLuyenDanStart(url) {
        try {
            const text = String(url || '');
            return /\/luyen-dan\/start(?:[/?#]|$)/i.test(text);
        } catch {
            return false;
        }
    }

    function patchPlainObject(obj) {
        if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return obj;
        return {
            ...obj,
            hire_dan_dong: true
        };
    }

    function patchBody(body) {
        if (body == null) {
            return JSON.stringify({ hire_dan_dong: true });
        }

        // JSON string - dang ma bot HH3D thuong su dung.
        if (typeof body === 'string') {
            try {
                const parsed = JSON.parse(body);
                if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
                    return JSON.stringify(patchPlainObject(parsed));
                }
            } catch {}

            // Fallback x-www-form-urlencoded.
            try {
                const params = new URLSearchParams(body);
                if ([...params.keys()].length) {
                    params.set('hire_dan_dong', 'true');
                    return params.toString();
                }
            } catch {}

            return body;
        }

        // URLSearchParams.
        try {
            if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) {
                const params = new URLSearchParams(body.toString());
                params.set('hire_dan_dong', 'true');
                return params;
            }
        } catch {}

        // FormData.
        try {
            if (typeof FormData !== 'undefined' && body instanceof FormData) {
                const copy = new FormData();
                for (const [key, value] of body.entries()) copy.append(key, value);
                copy.set('hire_dan_dong', 'true');
                return copy;
            }
        } catch {}

        return body;
    }

    function logInjected(url, body) {
        try {
            let preview = body;
            if (typeof body === 'string' && body.length > 500) preview = body.slice(0, 500) + '...';
            console.log(
                '[LuyenDan Tiêu Viêm] Đã gắn hire_dan_dong=true vào lệnh Khai hỏa:',
                url,
                preview
            );
        } catch {}
    }

    function installFetch(target, label) {
        try {
            if (!target || typeof target.fetch !== 'function') return false;

